rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Sbírka na dárek: kdokoli čte, přihlášený (anonymně) přidává, nikdo nemění ani nemaže
    match /artifacts/airpods-linda/public/data/contributions/{docId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['name', 'type', 'amount', 'timestamp', 'userId'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.timestamp == request.time
        && (
          (request.resource.data.type == 'equal' && request.resource.data.amount == null)
          || (request.resource.data.type == 'specific'
              && request.resource.data.amount is number
              && request.resource.data.amount > 0
              && request.resource.data.amount <= 6500)
        );
      allow update, delete: if false;
    }
  }
}
